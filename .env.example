# Customer NetBox — discovered hosts are written here; site prefixes read from here
NETBOX_URL=https://netbox.example.com
NETBOX_TOKEN=changeme
NETBOX_CUSTOMER_NAME=Example Corp
NETBOX_TENANT_ID=1
NETBOX_SYNC_INTERVAL=3600
# false for dev/test instances with self-signed certificates
NETBOX_VERIFY_SSL=true

# GT-T NetBox — read-only source of the managed-device list.
# The sync is scoped to NETBOX_TENANT_ID; set GTT_NETBOX_TENANT_ID only if
# the customer's tenant id differs in the GT-T instance.
GTT_NETBOX_URL=https://netbox.gt-t.example
GTT_NETBOX_TOKEN=changeme
GTT_NETBOX_TENANT_ID=
GTT_NETBOX_QUERY_PARAMS=status=active&limit=0

# CMD GraphQL API (segment -> site lookups)
CMD_API_URL=https://cmd.example.com/v1/graphql
CMD_TOKEN_URL=https://auth.example.com/oauth2/token
CMD_CLIENT_ID=changeme
CMD_CLIENT_SECRET=changeme
CMD_SCOPE=read

# Redis (use a DB separate from the halo backend's DB 0).
# REDIS_USERNAME only if the server uses ACL users (e.g. halo_app).
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_DB=1
REDIS_USERNAME=
REDIS_PASSWORD=

# Discovery / auto-registration
DISCOVERY_MIN_SIGHTINGS=5
DISCOVERY_MIN_DURATION_SECONDS=3600
DISCOVERY_SIGHTING_TTL=172800
DISCOVERY_PROMOTE_INTERVAL=300
DISCOVERY_MAX_CREATES_PER_RUN=20
DISCOVERY_AUTOCREATE_ENABLED=false
